# 行尾统一：bat 保持 CRLF（cmd 解析要求），其余 LF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.java text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.webmanifest text eol=lf

# 二进制不过滤
*.png binary
*.jpg binary
*.ico binary
*.apk binary
*.keystore binary
